---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { Lang } from '../i18n/index';

interface Props {
  lang:        Lang;
  title?:      string;
  description?: string;
}

const {
  lang,
  title       = 'Andre Ortiz Loyola Castañeda · MarTech & Full Stack Developer',
  description = lang === 'es'
    ? 'Portfolio profesional de Andre Ortiz Loyola Castañeda — MarTech & Full Stack Developer. Mérida, México.'
    : 'Professional portfolio of Andre Ortiz Loyola Castañeda — MarTech & Full Stack Developer. Mérida, México.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://andreiito.github.io');
const altLang      = lang === 'es' ? 'en' : 'es';
const altHref      = lang === 'es' ? '/en' : '/';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang={altLang} href={altHref} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:image"       content="/og-image.png" />

  <!-- Twitter -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body class="bg-cosmos text-white font-body antialiased">
  <Header lang={lang} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
