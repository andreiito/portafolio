---
import type { Lang } from '../../i18n/index';
import { t } from '../../i18n/index';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="contact" class="relative bg-cosmos/80 overflow-hidden">
  <!-- Subtle glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_80%,rgba(10,88,124,0.15)_0%,transparent_70%)] pointer-events-none" />

  <div class="section-container relative z-10">

    <span class="text-stellar font-mono text-xs tracking-widest uppercase">{tr.contact.label}</span>
    <div class="section-divider mt-3"></div>
    <h2 class="section-title">{tr.contact.title}</h2>
    <p class="section-subtitle">{tr.contact.description}</p>

    <div class="grid md:grid-cols-2 gap-12 items-start">

      <!-- Left: direct contact -->
      <div class="flex flex-col gap-5">

        <a
          href="mailto:oica950624@gmail.com"
          class="group flex items-center gap-4 p-4 rounded-xl border border-mid/20 bg-deep/5 hover:border-stellar/40 hover:bg-stellar/5 transition-all duration-200"
        >
          <div class="w-9 h-9 rounded-lg bg-deep/30 border border-mid/20 flex items-center justify-center text-stellar group-hover:bg-stellar/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div>
            <p class="text-mist/50 font-mono text-xs">{tr.contact.email_label}</p>
            <p class="text-white font-mono text-sm group-hover:text-stellar transition-colors">oica950624@gmail.com</p>
          </div>
        </a>

        <a
          href="https://www.linkedin.com/in/andre-ortiz-loyola-casta%C3%B1eda-2ab4ba197/"
          target="_blank" rel="noopener noreferrer"
          class="group flex items-center gap-4 p-4 rounded-xl border border-mid/20 bg-deep/5 hover:border-stellar/40 hover:bg-stellar/5 transition-all duration-200"
        >
          <div class="w-9 h-9 rounded-lg bg-deep/30 border border-mid/20 flex items-center justify-center text-stellar group-hover:bg-stellar/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
            </svg>
          </div>
          <div>
            <p class="text-mist/50 font-mono text-xs">LinkedIn</p>
            <p class="text-white font-mono text-sm group-hover:text-stellar transition-colors">Andre Ortiz Loyola Castañeda</p>
          </div>
        </a>

        <a
          href="https://github.com/andreiito/portafolio"
          target="_blank" rel="noopener noreferrer"
          class="group flex items-center gap-4 p-4 rounded-xl border border-mid/20 bg-deep/5 hover:border-stellar/40 hover:bg-stellar/5 transition-all duration-200"
        >
          <div class="w-9 h-9 rounded-lg bg-deep/30 border border-mid/20 flex items-center justify-center text-stellar group-hover:bg-stellar/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </div>
          <div>
            <p class="text-mist/50 font-mono text-xs">GitHub</p>
            <p class="text-white font-mono text-sm group-hover:text-stellar transition-colors">andreiito</p>
          </div>
        </a>

      </div>

      <!-- Right: form -->
      <form
        action="mailto:oica950624@gmail.com"
        method="POST"
        enctype="text/plain"
        class="flex flex-col gap-4"
      >
        <div class="flex flex-col gap-1.5">
          <label class="text-mist/50 font-mono text-xs">
            {lang === 'es' ? 'Nombre' : 'Name'}
          </label>
          <input
            type="text" name="name" required
            class="bg-deep/10 border border-mid/20 rounded-lg px-4 py-2.5 text-white text-sm
                   font-body placeholder-mist/25 outline-none
                   focus:border-stellar/50 focus:bg-stellar/5 transition-all duration-200"
            placeholder={lang === 'es' ? 'Tu nombre' : 'Your name'}
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-mist/50 font-mono text-xs">Email</label>
          <input
            type="email" name="email" required
            class="bg-deep/10 border border-mid/20 rounded-lg px-4 py-2.5 text-white text-sm
                   font-body placeholder-mist/25 outline-none
                   focus:border-stellar/50 focus:bg-stellar/5 transition-all duration-200"
            placeholder={lang === 'es' ? 'tu@email.com' : 'your@email.com'}
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-mist/50 font-mono text-xs">
            {lang === 'es' ? 'Mensaje' : 'Message'}
          </label>
          <textarea
            name="message" required rows={4}
            class="bg-deep/10 border border-mid/20 rounded-lg px-4 py-2.5 text-white text-sm
                   font-body placeholder-mist/25 outline-none resize-none
                   focus:border-stellar/50 focus:bg-stellar/5 transition-all duration-200"
            placeholder={lang === 'es' ? '¿En qué puedo ayudarte?' : 'How can I help you?'}
          />
        </div>

        <button type="submit" class="btn-primary self-start mt-2">
          {tr.contact.cta}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
          </svg>
        </button>
      </form>

    </div>
  </div>
</section>
