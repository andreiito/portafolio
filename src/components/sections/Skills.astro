---
import type { Lang } from '../../i18n/index';
import { t } from '../../i18n/index';
import { skillCategories } from '../../content/skills';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="skills" class="bg-cosmos">
  <div class="section-container">

    <span class="text-stellar font-mono text-xs tracking-widest uppercase">{tr.skills.label}</span>
    <div class="section-divider mt-3"></div>
    <h2 class="section-title">{tr.skills.title}</h2>

    <div class="mt-10 grid md:grid-cols-3 gap-8">
      {skillCategories.map((cat) => (
        <div class="flex flex-col gap-4">
          <h3 class="font-display font-medium text-white text-sm border-b border-mid/15 pb-3">
            {cat.name[lang]}
          </h3>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map(skill => (
              <span class="skill-tag">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
