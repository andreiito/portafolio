---
import type { Lang } from '../../i18n/index';
import { t } from '../../i18n/index';
import { projects } from '../../content/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="projects" class="bg-cosmos/80">
  <div class="section-container">

    <span class="text-stellar font-mono text-xs tracking-widest uppercase">{tr.projects.label}</span>
    <div class="section-divider mt-3"></div>
    <h2 class="section-title">{tr.projects.title}</h2>

    <div class="mt-10 grid md:grid-cols-2 gap-5">
      {projects.map((project) => (
        <article class="project-card group">

          <!-- Header -->
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <h3 class="font-display font-semibold text-white text-base group-hover:text-stellar transition-colors duration-200">
                {project.title[lang]}
              </h3>
              {project.confidential && (
                <span class="inline-flex items-center gap-1 text-mist/40 font-mono text-xs mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  {tr.projects.confidential}
                </span>
              )}
            </div>

            <!-- Links -->
            <div class="flex items-center gap-3 shrink-0">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank" rel="noopener noreferrer"
                  class="text-mist/40 hover:text-stellar transition-colors"
                  aria-label={tr.projects.view_code}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                    <path d="M9 18c-4.51 2-5-2-7-2"/>
                  </svg>
                </a>
              )}
              {project.live && (
                <a
                  href={project.live}
                  target="_blank" rel="noopener noreferrer"
                  class="text-mist/40 hover:text-stellar transition-colors"
                  aria-label={tr.projects.view_live}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/>
                  </svg>
                </a>
              )}
            </div>
          </div>

          <!-- Description -->
          <p class="text-white/55 text-sm leading-relaxed">
            {project.description[lang]}
          </p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mt-auto pt-2">
            {project.tags.map(tag => (
              <span class="skill-tag text-xs">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
